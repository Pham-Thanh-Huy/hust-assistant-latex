      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Use Case Diagram - Chatbot Hỏi Đáp Học Phần\n\nleft to right direction\n\nskinparam dpi 200\nskinparam shadowing false\n\nskinparam packageStyle rectangle\n\nskinparam nodesep 60\nskinparam ranksep 70\n\n\nskinparam usecase {\n    BackgroundColor #EAF2F8\n    BorderColor #2874A6\n    FontSize 14\n    MinimumWidth 120\n    MinimumHeight 60\n}\n\nskinparam actor {\n    FontSize 15\n    FontStyle bold\n}\n\nskinparam rectangle {\n    RoundCorner 25\n    BorderColor #154360\n}\n\n\n\n&#39;================ ACTOR =================\n\nactor \&quot;Student /\\nLecturer\\n\\nUser\&quot; as User\n\nactor \&quot;Administrator\\n\\nAdmin\&quot; as Admin\n\n\n\nrectangle \&quot;CHATBOT HỎI ĐÁP HỌC PHẦN SYSTEM\&quot; {\n\n\n&#39;================ USER FUNCTION =================\n\nusecase \&quot;Đăng ký\\ntài khoản\&quot; as UC_Register\n\nusecase \&quot;Đăng nhập\\nhệ thống\&quot; as UC_Login\n\n\nusecase \&quot;Đặt câu hỏi\\n(Text Chat)\&quot; as UC_Ask\n\nusecase \&quot;Nhận câu trả lời\\nTừ Chatbot\&quot; as UC_Answer\n\n\nusecase \&quot;Xử lý câu hỏi\\nbằng AI Chatbot\\n(RAG Pipeline)\&quot; as UC_RAG\n\n\nusecase \&quot;Thu âm câu hỏi\\nSpeech To Text\&quot; as UC_STT\n\nusecase \&quot;Nghe câu trả lời\\nText To Speech\&quot; as UC_TTS\n\n\nusecase \&quot;Xem lịch sử\\nChat\&quot; as UC_History\n\nusecase \&quot;Lưu lịch sử\\nhội thoại\&quot; as UC_SaveHistory\n\n\n\n&#39;================ ADMIN FUNCTION =================\n\nusecase \&quot;Quản lý\\nngười dùng\&quot; as UC_UserMng\n\nusecase \&quot;Quản lý Role\\nPermission\&quot; as UC_RBAC\n\n\nusecase \&quot;Cập nhật dữ liệu\\nhọc phần\&quot; as UC_Crawl\n\n\nusecase \&quot;Crawler dữ liệu\\nwebsite trường\&quot; as UC_Crawler\n\nusecase \&quot;Sinh Vector\\nEmbedding dữ liệu\\nhọc phần\&quot; as UC_Embedding\n\n\n}\n\n\n\n&#39;================ USER RELATION =================\n\nUser --&gt; UC_Register\n\nUser --&gt; UC_Login\n\nUser --&gt; UC_Ask\n\nUser --&gt; UC_STT\n\nUser --&gt; UC_TTS\n\nUser --&gt; UC_History\n\n\n\nUC_Ask --&gt; UC_RAG : &lt;&lt;include&gt;&gt;\n\nUC_RAG --&gt; UC_Answer : &lt;&lt;include&gt;&gt;\n\nUC_Ask --&gt; UC_SaveHistory : &lt;&lt;include&gt;&gt;\n\nUC_STT --&gt; UC_Ask : &lt;&lt;extend&gt;&gt;\n\nUC_TTS --&gt; UC_Answer : &lt;&lt;extend&gt;&gt;\n\n\n\n&#39;================ ADMIN RELATION =================\n\nAdmin --&gt; UC_UserMng\n\nAdmin --&gt; UC_RBAC\n\nAdmin --&gt; UC_Crawl\n\n\n\nUC_Crawl --&gt; UC_Crawler : &lt;&lt;include&gt;&gt;\n\nUC_Crawler --&gt; UC_Embedding : &lt;&lt;include&gt;&gt;\n\n\n\n&#39;================ ALIGN LAYOUT =================\n\nUC_Register -[hidden]- UC_Login\n\nUC_Ask -[hidden]- UC_RAG\n\nUC_RAG -[hidden]- UC_Answer\n\nUC_UserMng -[hidden]- UC_RBAC\n\nUC_Crawler -[hidden]- UC_Embedding\n\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="28rXqRb6s7_YJwu_8ZLp-979">
